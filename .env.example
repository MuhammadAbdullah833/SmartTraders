# Copy this file to .env and fill in your real values.

# Local MongoDB:
#   MONGODB_URI=mongodb://127.0.0.1:27017/smart_copy
# MongoDB Atlas (cloud, free tier is fine):
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart_copy?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smart_copy

# Port the API server listens on
PORT=5000

# Comma-separated list of origins allowed to call this API (your Vite dev server, your live site, etc.)
CLIENT_ORIGIN=http://localhost:5173,smarttraders.biz

# Secret used to sign admin login tokens — change this to any long random string
JWT_SECRET=change-this-to-a-long-random-string

# Used once by `npm run seed:admin` to create the admin login (login with these on the website)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
